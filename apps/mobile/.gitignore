# Machine-specific Xcode build environment: node path, backend LAN address.
ios/.xcode.env.local

# Generated by xcodegen from ios/project.yml -- a build artifact, not source.
ios/FaceType.xcodeproj/
ios/FaceType.xcworkspace/
ios/Pods/
ios/Podfile.lock
ios/build/

# Generated by `react-native bundle` before assembleDebug -- a build artifact.
# It is packaged into the APK, so committing it would ship a stale backend
# address and a stale copy of the app's JavaScript.
android/app/src/main/assets/index.android.bundle
# Fetched at build time by `fetchFaceLandmarkerModel`, from a pinned URL and
# verified against a pinned SHA-256 (app/build.gradle). A model binary in git
# is a 3.7 MB blob nobody can review in a diff; the pin is the reviewable part.
android/app/src/main/assets/face_landmarker.task
# The iOS copy of the same pinned model, cached by ios/scripts/fetch-face-landmarker.sh.
ios/Models/
android/app/src/main/res/drawable-*/
android/app/src/main/res/raw/

# Gradle
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.cxx/
