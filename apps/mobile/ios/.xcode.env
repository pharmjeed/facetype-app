# Environment for React Native's Xcode build phase.
#
# `react-native/scripts/xcode/with-environment.sh` sources this file, then
# `.xcode.env.local` if it exists, before running `react-native-xcode.sh`. That
# is the only hook through which the bundler's environment can be set from
# inside an Xcode build, so it is where the API base URL has to come from.
#
# Keep machine-specific values in `.xcode.env.local`, which is git-ignored:
#
#   echo 'export NODE_BINARY=$(command -v node)'          >  .xcode.env.local
#   echo 'export FACETYPE_API_URL=http://<lan-ip>:8000'   >> .xcode.env.local
#   echo 'export FACETYPE_ALLOW_CLEARTEXT=1'              >> .xcode.env.local
#
# Never commit a LAN address or a credential here.

export NODE_BINARY="${NODE_BINARY:-$(command -v node)}"

# Fail closed by default: with no URL inlined, a bundle built from a clean
# checkout reports API_URL_UNCONFIGURED instead of silently targeting loopback.
export FACETYPE_API_URL="${FACETYPE_API_URL:-}"
export FACETYPE_ALLOW_CLEARTEXT="${FACETYPE_ALLOW_CLEARTEXT:-0}"
