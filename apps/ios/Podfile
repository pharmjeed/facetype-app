# FaceType client app — native iOS. Two pods only:
# - MediaPipeTasksVision 0.10.35: the Face Landmarker the camera runs (same release as Android's tasks-vision).
# - GoogleSignIn: Google sign-in. Sign in with Apple is the system framework (AuthenticationServices).
platform :ios, '16.0'

target 'FaceType' do
  pod 'MediaPipeTasksVision', '0.10.35'
  pod 'GoogleSignIn', '8.0.0'

  target 'FaceTypeTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  # MediaPipeTasksCommon is a static framework that already contains GTMSessionFetcher's object files; GoogleSignIn
  # brings the GTMSessionFetcher pod as a second static library and the link fails with duplicate symbols. Link
  # only MediaPipe's copy; GoogleSignIn's references resolve against it. Headers still come from the pod.
  installer.aggregate_targets.each do |aggregate|
    aggregate.user_build_configurations.each_key do |config_name|
      path = aggregate.xcconfig_path(config_name)
      text = File.read(path)
      fixed = text.gsub(/ -l"GTMSessionFetcher"/, '')
      File.write(path, fixed) if fixed != text
    end
  end

  # Xcode 27 refuses pod targets below the supported minimum; raise every one to the app's own minimum.
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |build_config|
      current = build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
      if current.nil? || Gem::Version.new(current) < Gem::Version.new('16.0')
        build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
      end
    end
  end
end
